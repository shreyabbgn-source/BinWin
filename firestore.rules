rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // - uid: string (required)
    // - email: string (required)
    // - displayName: string
    // - points: int (required)
    // - totalRecycledWeight: number
    // - level: int
    //
    // Collection: rewards
    // - title: string (required)
    // - pointsCost: int (required)
    // - category: string
    //
    // Collection: bins
    // - locationName: string
    // - type: string
    // - status: string
    //
    // Collection: history
    // - userId: string (required)
    // - weight: number
    // - pointsEarned: int
    // - timestamp: timestamp
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == "shreyabbgn@gmail.com"
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'points']) &&
             data.uid is string &&
             data.email is string &&
             data.points is int &&
             data.points >= 0;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.points == resource.data.points) || isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /bins/{binId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /history/{historyId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
